[Unit]
Description=OlimpoTrade 2.0 Streamlit Dashboard (app_ui.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__VPS_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m streamlit run app_ui.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10
StandardOutput=append:__APP_DIR__/vps_ui_stdout.log
StandardError=append:__APP_DIR__/vps_ui_stderr.log

[Install]
WantedBy=multi-user.target
